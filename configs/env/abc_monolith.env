# Joint (monolith) A+B+C LoRA training. Best checkpoint: best_ep6.
RUN_NAME=abc_monolith_egoper_27b
DATASET=egoper
MODEL_NAME=unsloth/Qwen3.8-27B
NUM_GPUS=8
EXPECTED_WORLD_SIZE=8
MAX_VIDEOS=389
SPLIT_FILE=configs/splits/egoper_video_split_seed3407.json

FPS=1.0
MIN_FRAMES=2
MAX_FRAMES=54
EVAL_MAX_FRAMES=54
VISION_RESIZE=1024
MAX_SEQ_LENGTH=20480
VALIDATE_TOKEN_BUDGET=false
TOKEN_BUDGET_SAFETY_MARGIN=256
MEMORY_PREFLIGHT=false
MEMORY_PREFLIGHT_ONLY=false

TRAIN_MODE=epochs
MAX_STEPS=100
NUM_TRAIN_EPOCHS=6
EVAL_EPOCHS=1
CHECKPOINT_EPOCHS=1
EVAL_ON_RESUME=true
EVAL_GENERATION_MAX_SAMPLES=-1
EVAL_GENERATION_MAX_NEW_TOKENS=192
EVAL_GENERATION_BATCH_SIZE=2
EVAL_GENERATION_USE_CACHE=true
GENERATION_ENABLE_THINKING=false
MONOLITH_CANDIDATE_SCORING=false
METRIC_FOR_BEST_MODEL=eval_monolith/stage_composite
GREATER_IS_BETTER=true
REPORT_TO=tensorboard

LOAD_IN_4BIT=false
LOAD_IN_8BIT=false
LOAD_IN_16BIT=true
LORA_DTYPE=bfloat16
OPTIM=adamw_torch_fused
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.0
LORA_TARGET_MODULES=auto
FINETUNE_VISION_LAYERS=true
FINETUNE_LANGUAGE_LAYERS=true
FINETUNE_ATTENTION_MODULES=true
FINETUNE_MLP_MODULES=true

LEARNING_RATE=2e-4
WARMUP_STEPS=10
WEIGHT_DECAY=0.001
LR_SCHEDULER_TYPE=linear
MAX_GRAD_NORM=1.0

# Global batch = NUM_GPUS x PER_DEVICE_TRAIN_BATCH_SIZE x GRADIENT_ACCUMULATION_STEPS = 16.
PER_DEVICE_TRAIN_BATCH_SIZE=1
PER_DEVICE_EVAL_BATCH_SIZE=2
TARGET_GLOBAL_BATCH_SIZE=16
GRADIENT_ACCUMULATION_STEPS=2
GROUP_BY_LENGTH=true
DATALOADER_NUM_WORKERS=8
DATALOADER_PREFETCH_FACTOR=4
DATASET_NUM_PROC=1
TORCH_EMPTY_CACHE_STEPS=100
DDP_TIMEOUT=7200

HISTORY_MAX_EVENTS=12
HISTORY_DROPOUT_PROBABILITY=0.25
LATE_TRIGGER_RATIO=0.10
MAX_NATURAL_NOT_COMPLETED_PER_EPISODE=2
NON_CORRECT_OVERSAMPLE_FACTOR=4.0

KEEP_LAST_CHECKPOINTS=4
KEEP_BEST_CHECKPOINTS=4
EARLY_STOPPING_PATIENCE=5
EARLY_STOPPING_THRESHOLD=0.0
WANDB_ARTIFACT_PREFIX=abc-monolith
WANDB_LOG_BEST_CHECKPOINTS=false

OUTPUT_DIR=${OUTPUT_ROOT}/abc_monolith/runs/${RUN_NAME}
CKPT_DIR=${OUTPUT_ROOT}/abc_monolith/cluster_checkpoints/${RUN_NAME}
CLUSTER_SAVE_INTERVAL_SECONDS=3600
CLUSTER_KEEP_CHECKPOINTS=2
# Continue training: set one of these (see README, "Continue from a checkpoint").
RESUME=
RESUME_FROM_CHECKPOINT=
INITIAL_RESUME_FROM_CHECKPOINT=

UNSLOTH_COMPILE_DISABLE=1
UNSLOTH_RETURN_LOGITS=0
UNSLOTH_RETURN_HIDDEN_STATES=0
VIDEO_READER=decord
DRY_RUN=false
PRINT_EXAMPLES=2

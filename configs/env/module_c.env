# Module C (execution classification) LoRA training. Best checkpoint: best_ep4.
RUN_NAME=module_c_egoper_27b
DATASET=egoper
MODEL_NAME=unsloth/Qwen3.8-27B
NUM_GPUS=8
MAX_VIDEOS=389
SPLIT_FILE=configs/splits/egoper_video_split_seed3407.json
REGENERATE_SPLIT=false
TRAIN_VIDEOS_PER_TASK=
VAL_VIDEOS_PER_TASK=
TRAIN_VALIDATION_ERRONEOUS_ONLY=false

MAX_FRAMES=40
EVAL_MAX_FRAMES=40
VISION_RESIZE=0
MAX_SEQ_LENGTH=20480

TRAIN_MODE=epochs
MAX_STEPS=100
NUM_TRAIN_EPOCHS=6
EVAL_EPOCHS=1
EVAL_GENERATION_MAX_SAMPLES=-1
EVAL_GENERATION_MAX_NEW_TOKENS=128
EVAL_GENERATION_BATCH_SIZE=2
EVAL_GENERATION_USE_CACHE=true
GENERATION_ENABLE_THINKING=false
BERTSCORE_MODEL_TYPE=microsoft/deberta-xlarge-mnli
BERTSCORE_BATCH_SIZE=16
BERTSCORE_DEVICE=auto
METRIC_FOR_BEST_MODEL=eval_all/macro_f1
REPORT_TO=tensorboard

LOAD_IN_4BIT=false
LOAD_IN_8BIT=false
LOAD_IN_16BIT=true
LORA_DTYPE=bfloat16
OPTIM=adamw_torch_fused
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.0
LORA_TARGET_MODULES=auto
FINETUNE_VISION_LAYERS=false
FINETUNE_LANGUAGE_LAYERS=true
FINETUNE_ATTENTION_MODULES=true
FINETUNE_MLP_MODULES=true

LEARNING_RATE=2e-4
WARMUP_STEPS=10
WEIGHT_DECAY=0.001
LR_SCHEDULER_TYPE=linear
MAX_GRAD_NORM=1.0

# Global batch = NUM_GPUS x PER_DEVICE_TRAIN_BATCH_SIZE x GRADIENT_ACCUMULATION_STEPS = 16.
PER_DEVICE_TRAIN_BATCH_SIZE=1
PER_DEVICE_EVAL_BATCH_SIZE=2
TARGET_GLOBAL_BATCH_SIZE=16
GRADIENT_ACCUMULATION_STEPS=2
GROUP_BY_LENGTH=true
DATALOADER_NUM_WORKERS=8
DATALOADER_PREFETCH_FACTOR=4
TORCH_EMPTY_CACHE_STEPS=100
FPS=1.0
MIN_FRAMES=2

MODULE_C_MIN_DURATION_SECONDS=0.5
MODULE_C_JITTER_RATIO_MIN=0.05
MODULE_C_JITTER_RATIO_MAX=0.10
INCLUDE_NOT_COMPLETED_EXAMPLES=true
MODULE_C_NOT_COMPLETED_RATIO=0.10
MODULE_C_HISTORY_MAX_EVENTS=12
MODULE_C_HISTORY_DROPOUT_PROBABILITY=0.25
MODULE_C_NON_CORRECT_OVERSAMPLE_FACTOR=4.0
ZERO_SHOT_EVAL=false

VAL_FRACTION=0.2
CHECKPOINT_EPOCHS=1
KEEP_LAST_CHECKPOINTS=4
KEEP_BEST_CHECKPOINTS=4
EARLY_STOPPING_PATIENCE=5
EARLY_STOPPING_THRESHOLD=0.0
GREATER_IS_BETTER=true
WANDB_ARTIFACT_PREFIX=module-c
WANDB_LOG_BEST_CHECKPOINTS=false

UNSLOTH_COMPILE_DISABLE=1
VIDEO_READER=decord
OUTPUT_DIR=${OUTPUT_ROOT}/module_c/runs/${RUN_NAME}
CLUSTER_SAVE_INTERVAL_SECONDS=3600
CLUSTER_KEEP_CHECKPOINTS=2
# Continue training: set one of these (see README, "Continue from a checkpoint").
RESUME_FROM_CHECKPOINT=
INITIAL_RESUME_FROM_CHECKPOINT=
DRY_RUN=false
PRINT_EXAMPLES=2

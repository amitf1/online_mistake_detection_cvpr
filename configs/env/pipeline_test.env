# Modular system: causal online A -> B -> C on the EgoPER test split.
# Re-run the same command until work_queue/progress.json reports complete=true.
RUN_NAME=pipeline_egoper_27b_test
DATASET=egoper
MODEL_NAME=unsloth/Qwen3.8-27B
NUM_GPUS=2
SHARD_VIDEOS=true
SHARD_MODE=queue
EVAL_SPLIT=test
MAX_VIDEOS=389
SPLIT_FILE=configs/splits/egoper_video_split_seed3407.json
REGENERATE_SPLIT=false
TRAIN_VIDEOS_PER_TASK=
VAL_VIDEOS_PER_TASK=
MAX_SAMPLES=-1
REPORT_TO=

CAUSAL_STREAM=true
CAUSAL_MODULE_C_IN_LOOP=true
CAUSAL_MAX_VIDEOS=-1
LOAD_IN_4BIT=false
LOAD_IN_8BIT=false
LOAD_IN_16BIT=true

FPS=1.0
MIN_FRAMES=2
MAX_FRAMES_A=32
MAX_FRAMES_B=54
MAX_FRAMES_C=40
VISION_RESIZE_A=1024
VISION_RESIZE_B=1024
VISION_RESIZE_C=0
MAX_SEQ_LENGTH_A=12288
MAX_SEQ_LENGTH_B=20480
MAX_SEQ_LENGTH_C=20480
MODULE_A_MAX_NEW_TOKENS=8
MODULE_B_MAX_NEW_TOKENS=64
MODULE_C_MAX_NEW_TOKENS=128
MODULE_C_HISTORY_MAX_EVENTS=12
MODULE_C_CANDIDATE_SCORING=true
MODULE_C_SCORE_ONLY=false

MODULE_A_LABEL_MODE=step_id
LABEL_SCORE_EVAL=true
ONLINE_RESET_FROM_B=true
STRIDE_SECONDS=5.0
ZERO_SHOT_EVAL=false

# Released adapters (see README, "Checkpoints"). Use "auto" together with
# MODULE_X_RUN_DIR to pick the best checkpoint of your own training run.
MODULE_A_CHECKPOINT=checkpoints/module_a/best_ep6
MODULE_B_CHECKPOINT=checkpoints/module_b/best_ep4
MODULE_C_CHECKPOINT=checkpoints/module_c/best_ep4

DEFER_METRICS=true
REUSE_EVENTS_JSON=
SKIP_INFERENCE=false

UNSLOTH_COMPILE_DISABLE=1
VIDEO_READER=decord
OUTPUT_DIR=${OUTPUT_ROOT}/online_pipeline_eval/${RUN_NAME}
DRY_RUN=false

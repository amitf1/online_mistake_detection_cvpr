# Joint system on the EgoPER test split.
# Re-run the same command until work_queue/progress.json reports complete=true.
RUN_NAME=abc_monolith_egoper_27b_test
DATASET=egoper
MODEL_NAME=unsloth/Qwen3.8-27B
# Released adapter (see README, "Checkpoints"). Use "auto" together with
# RUN_DIR to pick the best checkpoint of your own training run.
CHECKPOINT=checkpoints/abc_monolith/best_ep6
SPLIT_FILE=configs/splits/egoper_video_split_seed3407.json
EVAL_SPLIT=test
NUM_GPUS=2

MAX_SEQ_LENGTH=20480
MAX_NEW_TOKENS=192
FPS=1.0
MIN_FRAMES=2
MAX_FRAMES=54
VISION_RESIZE=1024
LOAD_IN_4BIT=false
LOAD_IN_8BIT=false
LOAD_IN_16BIT=true
USE_CACHE=true
MONOLITH_CANDIDATE_SCORING=true
DEFER_METRICS=true

UNSLOTH_COMPILE_DISABLE=1
VIDEO_READER=decord
OUTPUT_DIR=${OUTPUT_ROOT}/abc_monolith/eval/${RUN_NAME}
